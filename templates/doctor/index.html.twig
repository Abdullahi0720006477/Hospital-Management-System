{% extends 'page_layout.html.twig' %}

{% block page_title %}Medical Staff{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">Doctors</li>
{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_doctor_new') }}" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-person-plus-fill me-2"></i>Add New Doctor
    </a>
{% endblock %}

{% block page_content %}
<div class="glass-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle table-glass" id="doctorTable">
            <thead>
                <tr>
                    <th>Doctor Name</th>
                    <th>Department</th>
                    <th>Specialization</th>
                    <th>Experience</th>
                    <th>Fee</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for doctor in doctors %}
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 40px; height: 40px;">
                                {{ doctor.user ? doctor.user.fullName|slice(0, 1)|upper : 'D' }}
                            </div>
                            <div>
                                <div class="fw-bold">{{ doctor.user ? doctor.user.fullName : 'Unknown Doctor' }}</div>
                                <small class="text-muted">{{ doctor.user ? doctor.user.email : 'No Email' }}</small>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-light text-dark border">{{ doctor.department ? doctor.department.name : 'Unassigned' }}</span>
                    </td>
                    <td>{{ doctor.specialization }}</td>
                    <td>
                        <span class="fw-semibold">{{ doctor.experience }}</span> <small class="text-muted">Years</small>
                    </td>
                    <td class="fw-bold text-success">${{ doctor.consultationFee }}</td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li><a class="dropdown-item" href="{{ path('app_doctor_show', {'id': doctor.id}) }}"><i class="bi bi-eye me-2"></i>Show Details</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_doctor_edit', {'id': doctor.id}) }}"><i class="bi bi-pencil me-2"></i>Edit Doctor</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" action="{{ path('app_doctor_delete', {'id': doctor.id}) }}" onsubmit="return confirm('Are you sure you want to delete this doctor?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ doctor.id) }}">
                                        <button class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
    <style>
        .dataTables_wrapper .dataTables_filter { margin-bottom: 1rem; }
        .dataTables_wrapper .dataTables_paginate { margin-top: 1rem; }
    </style>
{% endblock %}

{% block javascripts %}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(document).ready(function() {
        $('#doctorTable').DataTable({
            "pageLength": 10,
            "language": {
                "search": "_INPUT_",
                "searchPlaceholder": "Search doctors..."
            }
        });
    });
</script>
{% endblock %}
