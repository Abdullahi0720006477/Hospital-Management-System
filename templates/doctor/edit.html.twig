{% extends 'page_layout.html.twig' %}

{% block page_title %}Edit Doctor Profile{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('app_doctor_index') }}">Doctors</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_doctor_show', {'id': doctor.id}) }}">{{ doctor.user.fullName }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit</li>
{% endblock %}

{% block page_actions %}
    <form method="post" action="{{ path('app_doctor_delete', {'id': doctor.id}) }}" onsubmit="return confirm('Are you sure you want to delete this doctor?');" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ doctor.id) }}">
        <button class="btn btn-outline-danger rounded-pill px-4"><i class="bi bi-trash me-2"></i>Delete Doctor</button>
    </form>
{% endblock %}

{% block page_content %}
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="glass-card p-5">
            <div class="d-flex align-items-center mb-5">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center text-primary fw-bold me-4" style="width: 80px; height: 80px; font-size: 2rem;">
                    {{ doctor.user.fullName|slice(0, 1)|upper }}
                </div>
                <div>
                    <h4 class="fw-bold mb-1">{{ doctor.user.fullName }}</h4>
                    <p class="text-muted mb-0">{{ doctor.specialization }}</p>
                </div>
            </div>

            {{ form_start(form) }}
                <h5 class="fw-bold text-primary mb-4"><i class="bi bi-hospital me-2"></i>Professional Details</h5>
                <div class="row g-4">
                    <div class="col-md-6">
                         {{ form_label(form.department, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                         {{ form_widget(form.department, {'attr': {'class': 'form-select rounded-3 bg-light border-0 p-3'}}) }}
                    </div>
                    <div class="col-md-6">
                         {{ form_label(form.specialization, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                         {{ form_widget(form.specialization, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3'}}) }}
                    </div>
                    <div class="col-md-6">
                         {{ form_label(form.experience, 'Experience (Years)', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                         {{ form_widget(form.experience, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3', 'type': 'number'}}) }}
                    </div>
                    <div class="col-md-6">
                         {{ form_label(form.consultationFee, 'Consultation Fee ($)', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                         {{ form_widget(form.consultationFee, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3', 'type': 'number'}}) }}
                    </div>
                </div>

                <div class="mt-5 d-flex justify-content-between align-items-center">
                    <a href="{{ path('app_doctor_index') }}" class="btn btn-light rounded-pill px-4 shadow-sm text-decoration-none text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                    <button class="btn btn-primary rounded-pill px-5 py-3 shadow-lg fw-bold">
                        <i class="bi bi-check-lg me-1"></i> Update Profile
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
