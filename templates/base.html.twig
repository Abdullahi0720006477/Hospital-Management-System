<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Hospital Management System{% endblock %}</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background: #f8f9fa; }
        
        /* Video Hero Section */
        .hero-video {
            position: relative;
            height: 100vh; /* Full viewport height */
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .hero-video__bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
        }
        .hero-video__overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.4));
            z-index: 1;
        }
        .hero-video__content {
            position: relative;
            z-index: 2;
            color: white;
            text-align: center;
        }

        /* Transparent Overlay Navbar */
        .navbar-overlay {
            background-color: transparent !important;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: absolute;
            top: 0;
            width: 100%;
            z-index: 1030;
            padding: 2rem 0; /* More initial breathing room */
        }
        .navbar-overlay.scrolled {
            background: rgba(255, 255, 255, 0.9) !important;
            backdrop-filter: blur(30px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            position: fixed;
            padding: 0.7rem 0;
        }
        .navbar-overlay.scrolled .nav-link {
            color: #1a202c !important;
        }
        .navbar-overlay.scrolled .navbar-brand span {
            color: #1a202c !important;
        }
        .navbar-brand img {
            height: 40px;
            width: auto;
        }
        .navbar-overlay .nav-link {
            color: rgba(255,255,255,0.95);
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.3s ease;
        }
        .navbar-overlay .nav-link:hover {
            color: #fff;
        }

        /* Footer Social Icons */
        .social-icon {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(0,0,0,0.05);
            color: #555;
            border-radius: 50%;
            transition: all 0.3s;
            text-decoration: none;
        }
        .social-icon:hover {
            background: #0d6efd;
            color: white;
            transform: translateY(-3px);
        }

        /* Global Glassmorphism Utilities */
        :root {
            --glass-bg: rgba(255, 255, 255, 0.8);
            --glass-border: rgba(255, 255, 255, 0.5);
        }
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: 0 10px 40px -10px rgba(0, 64, 128, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 50px -15px rgba(0, 64, 128, 0.2);
        }
        /* Progressive Dark Mode */
        body.dark-mode {
            background: #0f172a;
            color: #f8fafc;
        }
        body.dark-mode .navbar-overlay:not(.scrolled) .nav-link { color: white; }
        body.dark-mode .navbar-overlay.scrolled {
            background: rgba(15, 23, 42, 0.9) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        body.dark-mode .navbar-overlay.scrolled .nav-link { color: #f8fafc !important; }
        body.dark-mode .bg-white, body.dark-mode section.bg-white { background: #0f172a !important; color: #f8fafc; }
        body.dark-mode .glass-card { background: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.1); }
        body.dark-mode footer { background: #0f172a !important; border-top-color: rgba(255, 255, 255, 0.05) !important; }
        body.dark-mode .text-dark { color: #f1f5f9 !important; }
        body.dark-mode .text-muted { color: #94a3b8 !important; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

{# Navbar (Top Overlay) #}
{% block navbar %}
<nav class="navbar navbar-expand-lg navbar-dark navbar-overlay">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_home') }}">
            <img src="{{ asset('images/logo.png') }}" alt="MediCore Logo" style="height: 45px; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
            <span class="fw-bold tracking-tight text-white fs-4">{{ system_settings.hospitalName|default('MediCore') }}</span>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center gap-4">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_about') }}">About</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_gallery') }}">Gallery</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_contact') }}">Contact</a></li>
                <li class="nav-item">
                    <button class="btn btn-link nav-link px-2 mt-1" id="publicThemeToggle" title="Toggle Theme">
                        <i class="bi bi-moon-stars-fill fs-5"></i>
                    </button>
                </li>
                <li class="nav-item">
                    {% if app.user %}
                        {% if app.request.attributes.get('_route') != 'app_home' %}
                            {% set dashboard_route = 'app_home' %}
                            {% if is_granted('ROLE_ADMIN') %}
                                {% set dashboard_route = 'app_admin_dashboard' %}
                            {% elseif is_granted('ROLE_DOCTOR') %}
                                {% set dashboard_route = 'app_doctor_dashboard' %}
                            {% elseif is_granted('ROLE_PATIENT') %}
                                {% set dashboard_route = 'app_patient_dashboard' %}
                            {% endif %}
                            <div class="d-flex align-items-center gap-2">
                                <a class="btn btn-primary rounded-pill px-4 shadow-sm" href="{{ path(dashboard_route) }}">
                                   Dashboard
                                </a>
                                <a class="nav-link p-0 ms-2" href="{{ path('app_logout') }}" title="Logout">
                                   <i class="bi bi-box-arrow-right fs-5"></i>
                                </a>
                            </div>
                        {% else %}
                             <a class="nav-link p-0 ms-2" href="{{ path('app_logout') }}" title="Logout">
                               <i class="bi bi-box-arrow-right fs-5 text-white"></i>
                            </a>
                        {% endif %}
                    {% else %}
                        <a class="btn btn-primary rounded-pill px-5 shadow-sm py-2 fw-bold" href="{{ path('app_login') }}">
                            Login
                        </a>
                    {% endif %}
                </li>
            </ul>
        </div>
    </div>
</nav>
{% endblock %}

{% block body %}{% endblock %}

<footer class="bg-white py-5 border-top" id="contact">
    <div class="container">
        <div class="row gy-4 justify-content-between">
            <div class="col-lg-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <img src="{{ asset('images/logo.png') }}" alt="Logo" style="height: 40px; filter: grayscale(100%); opacity: 0.8;">
                    <h5 class="fw-bold mb-0 text-dark">{{ system_settings.hospitalName|default('MediCore Hospital') }}</h5>
                </div>
                <p class="text-muted small">
                    A professional academic project built with Symfony + MySQL.
                    Providing secure and efficient management for patients and doctors.
                </p>
                <div class="d-flex gap-2">
                    <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="social-icon"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="social-icon"><i class="bi bi-linkedin"></i></a>
                    <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
                </div>
            </div>
            <div class="col-lg-2">
                <h6 class="fw-bold mb-3">Links</h6>
                <ul class="list-unstyled text-muted small d-flex flex-column gap-2">
                    <li><a href="#" class="text-decoration-none text-muted">Home</a></li>
                    <li><a href="#features" class="text-decoration-none text-muted">Features</a></li>
                    <li><a href="#about" class="text-decoration-none text-muted">About Us</a></li>
                    <li><a href="{{ path('app_login') }}" class="text-decoration-none text-muted">Login</a></li>
                </ul>
            </div>
            <div class="col-lg-3">
                <h6 class="fw-bold mb-3">Contact</h6>
                <ul class="list-unstyled text-muted small d-flex flex-column gap-2">
                    <li><i class="bi bi-geo-alt me-2"></i> 123 Academic St, University Campus</li>
                    <li><i class="bi bi-envelope me-2"></i> contact@hospital-hms.test</li>
                    <li><i class="bi bi-telephone me-2"></i> +1 (555) 123-4567</li>
                </ul>
            </div>
        </div>
        <div class="border-top mt-4 pt-4 text-center text-muted small">
            © {{ "now"|date("Y") }} Hospital Management System. All rights reserved.
        </div>
    </div>
</footer>

{# Chatbot Widget #}
<div id="chatbot-container" class="chatbot-container">
    <!-- Chat Button -->
    <button id="chatbot-toggle" class="chatbot-toggle shadow-lg">
        <i class="bi bi-chat-dots-fill fs-4"></i>
    </button>

    <!-- Chat Window -->
    <div id="chatbot-window" class="chatbot-window shadow-lg d-none">
        <div class="chatbot-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-white bg-opacity-20 rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                    <i class="bi bi-robot fs-4"></i>
                </div>
                <div>
                   <div class="fw-bold lh-1">{{ system_settings.hospitalName|default('MediCore') }} AI</div>
                   <small class="opacity-75">Online Support</small>
                </div>
            </div>
            <button id="chatbot-close" class="btn btn-sm btn-link text-white p-0">
                <i class="bi bi-x-lg fs-5"></i>
            </button>
        </div>
        
        <div id="chatbot-messages" class="chatbot-messages">
            <!-- Initial Message -->
            <div class="message bot-message">
                <div class="content">
                    Hello! 👋 I'm your {{ system_settings.hospitalName|default('MediCore') }} health assistant. How can I assist you today?
                    <div class="mt-2">
                        <span class="suggestion-badge" onclick="chatbotAutoSend('Pharmacy')">Pharmacy</span>
                        <span class="suggestion-badge" onclick="chatbotAutoSend('Doctors')">Doctors</span>
                        <span class="suggestion-badge" onclick="chatbotAutoSend('Login')">Login</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="chatbot-input">
            <div class="input-wrapper">
                <input type="text" id="chatbot-input-field" placeholder="Type your question...">
                <button id="chatbot-send" class="send-btn">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Chatbot UI */
    .chatbot-container {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 9999;
        font-family: 'Outfit', sans-serif;
    }

    .chatbot-toggle {
        width: 65px;
        height: 65px;
        border-radius: 20px;
        background: linear-gradient(135deg, #4361ee, #4cc9f0);
        color: white;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 15px 35px rgba(67, 97, 238, 0.3);
    }

    .chatbot-toggle:hover {
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0 20px 45px rgba(67, 97, 238, 0.4);
    }

    .chatbot-window {
        position: absolute;
        bottom: 85px;
        right: 0;
        width: 380px;
        height: 550px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 35px;
        display: flex;
        flex-direction: column;
        transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        opacity: 0;
        transform: translateY(40px) scale(0.9);
        pointer-events: none;
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    .chatbot-window.active {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: all;
    }

    .chatbot-header {
        background: linear-gradient(90deg, #4361ee, #4cc9f0);
        padding: 1.5rem;
        color: white;
    }

    .chatbot-messages {
        flex-grow: 1;
        overflow-y: auto;
        padding: 1.5rem;
        scrollbar-width: thin;
        scrollbar-color: rgba(0,0,0,0.1) transparent;
    }

    .chatbot-messages::-webkit-scrollbar {
        width: 6px;
    }
    .chatbot-messages::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,0.1);
        border-radius: 10px;
    }

    .message {
        margin-bottom: 1.25rem;
        max-width: 85%;
        animation: messageIn 0.3s ease forwards;
    }

    @keyframes messageIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .bot-message { text-align: left; margin-right: auto; }
    .user-message { text-align: right; margin-left: auto; }

    .bot-message .content {
        background: #f1f5f9;
        color: #1e293b;
        padding: 12px 18px;
        border-radius: 20px 20px 20px 5px;
        display: inline-block;
        font-size: 0.9rem;
        line-height: 1.5;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }

    .user-message .content {
        background: #4361ee;
        color: white;
        padding: 12px 18px;
        border-radius: 20px 20px 5px 20px;
        display: inline-block;
        font-size: 0.9rem;
        line-height: 1.5;
        box-shadow: 0 10px 20px rgba(67, 97, 238, 0.15);
    }

    .suggestion-badge {
        font-size: 0.75rem;
        padding: 6px 14px;
        border-radius: 100px;
        background: white;
        color: #4361ee;
        border: 1px solid rgba(67, 97, 238, 0.2);
        cursor: pointer;
        transition: all 0.2s ease;
        margin-right: 5px;
        margin-top: 8px;
        display: inline-block;
    }

    .suggestion-badge:hover {
        background: #4361ee;
        color: white;
        transform: translateY(-2px);
    }

    .chatbot-input {
        padding: 1.25rem;
        background: white;
        border-top: 1px solid #f1f5f9;
    }

    .input-wrapper {
        display: flex;
        gap: 10px;
        background: #f8fafc;
        padding: 8px;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
    }

    .input-wrapper input {
        border: none;
        background: transparent;
        flex-grow: 1;
        font-size: 0.9rem;
        padding-left: 10px;
    }

    .input-wrapper input:focus { outline: none; }

    .send-btn {
        width: 40px;
        height: 40px;
        border-radius: 15px;
        background: #4361ee;
        color: white;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .send-btn:hover { background: #3a0ca3; transform: scale(1.05); }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Navbar Scroll Effect
    window.addEventListener('scroll', function() {
        const nav = document.querySelector('.navbar-overlay');
        if (nav) {
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        }
    });

    // Chatbot Logic
    function chatbotAutoSend(text) {
        document.getElementById('chatbot-input-field').value = text;
        document.getElementById('chatbot-send').click();
    }

    document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.getElementById('chatbot-toggle');
        const closeBtn = document.getElementById('chatbot-close');
        const chatWindow = document.getElementById('chatbot-window');
        const sendBtn = document.getElementById('chatbot-send');
        const inputField = document.getElementById('chatbot-input-field');
        const messagesContainer = document.getElementById('chatbot-messages');

        const toggleChat = () => {
            chatWindow.classList.toggle('d-none');
            setTimeout(() => chatWindow.classList.toggle('active'), 10);
        };

        toggleBtn.addEventListener('click', toggleChat);
        closeBtn.addEventListener('click', toggleChat);

        const sendMessage = () => {
            const text = inputField.value.trim();
            if(!text) return;

            addMessage(text, 'user');
            inputField.value = '';

            setTimeout(() => {
                const reply = getBotReply(text.toLowerCase());
                addMessage(reply, 'bot');
            }, 600);
        };

        sendBtn.addEventListener('click', sendMessage);
        inputField.addEventListener('keypress', (e) => {
            if(e.key === 'Enter') sendMessage();
        });

        function addMessage(text, sender) {
            const div = document.createElement('div');
            div.className = `message ${sender}-message`;
            div.innerHTML = `<div class="content">${text}</div>`;
            
            messagesContainer.appendChild(div);
            messagesContainer.scrollTo({
                top: messagesContainer.scrollHeight,
                behavior: 'smooth'
            });
        }

        function getBotReply(msg) {
            if(msg.includes('hello') || msg.includes('hi')) return "Hello! How can I help you today?";
            if(msg.includes('pharmacy')) return "Our Pharmacy is located on the 1st Floor. Open 24/7.";
            if(msg.includes('doctor')) return "We have specialists in Cardiology, Neurology, and Pediatrics. Please login to book.";
            if(msg.includes('login') || msg.includes('admin')) return "Click the 'Login' button in the top right corner to access the dashboard.";
            return "I'm just a simple bot. Please contact our reception for more details!";
        }
    });

    // Make chatbotAutoSend global so onclick can find it
    window.chatbotAutoSend = chatbotAutoSend;

    // Public Theme Toggle logic
    document.addEventListener('DOMContentLoaded', () => {
        const themeToggle = document.getElementById('publicThemeToggle');
        const body = document.body;
        const icon = themeToggle ? themeToggle.querySelector('i') : null;
        
        const currentTheme = localStorage.getItem('theme');
        if (currentTheme === 'dark') {
            body.classList.add('dark-mode');
            if(icon) icon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
        }

        if (themeToggle) {
            themeToggle.addEventListener('click', () => {
                body.classList.toggle('dark-mode');
                const isDark = body.classList.contains('dark-mode');
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
                if(icon) {
                    if (isDark) icon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
                    else icon.classList.replace('bi-sun-fill', 'bi-moon-stars-fill');
                }
            });
        }
    });
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
