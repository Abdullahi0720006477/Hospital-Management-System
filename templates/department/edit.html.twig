{% extends 'page_layout.html.twig' %}

{% block page_title %}Edit Department{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('app_department_index') }}">Departments</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_department_show', {'id': department.id}) }}">{{ department.name }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit</li>
{% endblock %}

{% block page_actions %}
    {{ include('department/_delete_form.html.twig') }}
{% endblock %}

{% block page_content %}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="glass-card p-5">
            <h4 class="fw-bold text-primary mb-4 text-center">Edit Department Details</h4>
            {{ form_start(form) }}
                <div class="mb-4">
                    {{ form_row(form.name, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3'}}) }}
                </div>
                <div class="mb-4">
                     {{ form_row(form.description, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3', 'rows': '4'}}) }}
                </div>
                 
                {# Render any other fields #}
                {% for child in form %}
                    {% if child.vars.name not in ['name', 'description', '_token'] %}
                        <div class="mb-4">
                            {{ form_row(child, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3'}}) }}
                        </div>
                    {% endif %}
                {% endfor %}

                <div class="mt-5 d-flex justify-content-between align-items-center">
                    <a href="{{ path('app_department_index') }}" class="btn btn-light rounded-pill px-4 shadow-sm text-decoration-none text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                    <button class="btn btn-primary rounded-pill px-5 py-3 shadow-lg fw-bold">
                        <i class="bi bi-check-lg me-1"></i> Update Department
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
