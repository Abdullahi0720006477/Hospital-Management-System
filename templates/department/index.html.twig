{% extends 'page_layout.html.twig' %}

{% block page_title %}Departments{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">Departments</li>
{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_department_new') }}" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Add Department
    </a>
{% endblock %}

{% block page_content %}
<div class="glass-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle table-glass">
            <thead>
                <tr>
                    <th>Department Name</th>
                    <th>Description</th>
                    <th class="text-center">Staff Count</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for department in departments %}
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                                <i class="bi bi-building fs-5"></i>
                            </div>
                            <div class="fw-bold">{{ department.name }}</div>
                        </div>
                    </td>
                    <td class="text-muted">{{ department.description|slice(0, 80) }}{{ department.description|length > 80 ? '...' : '' }}</td>
                    <td class="text-center">
                        <span class="badge bg-light text-dark border rounded-pill px-3">{{ department.doctors|length }} Doctors</span>
                    </td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li><a class="dropdown-item" href="{{ path('app_department_show', {'id': department.id}) }}"><i class="bi bi-eye me-2"></i>View Details</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_department_edit', {'id': department.id}) }}"><i class="bi bi-pencil me-2"></i>Edit Department</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center py-5 text-muted">
                        <i class="bi bi-building-dash fs-1 d-block mb-3 opacity-50"></i>
                        No departments found.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
