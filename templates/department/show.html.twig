{% extends 'page_layout.html.twig' %}

{% block page_title %}Department Details{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('app_department_index') }}">Departments</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ department.name }}</li>
{% endblock %}

{% block page_actions %}
    <div class="d-flex gap-2">
        <a href="{{ path('app_department_edit', {'id': department.id}) }}" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-pencil me-2"></i>Edit
        </a>
        <form method="post" action="{{ path('app_department_delete', {'id': department.id}) }}" onsubmit="return confirm('Are you sure you want to delete this department?');" class="d-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ department.id) }}">
            <button class="btn btn-outline-danger rounded-pill px-4"><i class="bi bi-trash me-2"></i>Delete</button>
        </form>
    </div>
{% endblock %}

{% block page_content %}
<div class="row g-4">
    <div class="col-12">
        <div class="glass-card p-5 mb-4 text-center">
             <div class="rounded-pill bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-3 px-4 py-3">
                <i class="bi bi-building fs-1"></i>
            </div>
            <h2 class="fw-bold mb-3">{{ department.name }}</h2>
            <p class="lead text-muted mx-auto" style="max-width: 700px;">{{ department.description ?: 'No description provided for this department.' }}</p>
        </div>
    </div>

    <div class="col-12">
        <div class="glass-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0">Assigned Medical Staff</h4>
                <span class="badge bg-light text-dark border rounded-pill px-3">{{ department.doctors|length }} Doctors</span>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle table-glass">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Specialization</th>
                            <th>Experience</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for doctor in department.doctors %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle bg-info bg-opacity-10 text-info me-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        {{ doctor.user.fullName|slice(0, 1)|upper }}
                                    </div>
                                    <div class="fw-bold">{{ doctor.user.fullName }}</div>
                                </div>
                            </td>
                            <td class="text-muted">{{ doctor.specialization }}</td>
                            <td>{{ doctor.experience }} years</td>
                            <td><span class="badge bg-success rounded-pill px-3">Active</span></td>
                            <td class="text-end">
                                <a href="{{ path('app_doctor_show', {'id': doctor.id}) }}" class="btn btn-sm btn-light rounded-circle shadow-sm">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x fs-2 d-block mb-2 opacity-50"></i>
                                No doctors assigned to this department yet.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
