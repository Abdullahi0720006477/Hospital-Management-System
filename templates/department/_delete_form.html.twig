<form method="post" action="{{ path('app_department_delete', {'id': department.id}) }}" onsubmit="return confirm('Are you sure you want to delete this department?');" style="display:inline-block">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ department.id) }}">
    <button class="btn btn-outline-danger rounded-pill px-4"><i class="bi bi-trash me-2"></i>Delete</button>
</form>
