{% extends 'dashboard_layout.html.twig' %}

{% block title %}My Health Dashboard | {{ patient.user.fullName }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* 2026 Premium Design System */
        :root {
            --patient-primary: linear-gradient(135deg, #05cd99 0%, #00a878 100%);
            --patient-accent: linear-gradient(135deg, #4361ee 0%, #3a0ca3 100%);
            --patient-warning: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --glass-bg: rgba(255, 255, 255, 0.95);
            --glass-border: 1px solid rgba(255, 255, 255, 0.5);
        }

        /* Animated Hero Section */
        .patient-hero {
            background: var(--patient-primary);
            background-size: 200% 200%;
            animation: gradientShift 15s ease infinite;
            border-radius: 28px;
            padding: 3rem;
            color: white;
            margin-bottom: 2.5rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(5, 205, 153, 0.3);
        }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .patient-hero::after {
            content: '';
            position: absolute;
            right: -50px;
            top: -50px;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
            border-radius: 50%;
            animation: pulse 4s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.1); opacity: 0.8; }
        }

        /* Vitals Cards with Hover Logic */
        .vitals-card {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 20px;
            border: var(--glass-border);
            box-shadow: 0 10px 30px rgba(0,0,0,0.03);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .vitals-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--patient-primary);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .vitals-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
        }

        .vitals-card:hover::before {
            opacity: 1;
        }

        .vitals-icon {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            transition: all 0.3s ease;
            box-shadow: 0 8px 16px rgba(0,0,0,0.05);
        }

        .vitals-card:hover .vitals-icon {
            transform: rotateY(360deg) scale(1.1);
        }

        /* Health Score Circle */
        .health-score-circle {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            border: 6px solid rgba(255,255,255,0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.75rem;
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(5px);
            box-shadow: 0 0 20px rgba(255,255,255,0.2);
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        /* Appointment Cards */
        .appointment-card-flat {
            background: white;
            border-radius: 20px;
            padding: 1.25rem;
            margin-bottom: 1rem;
            border: 1px solid rgba(0,0,0,0.03);
            border-left: 5px solid #4361ee;
            transition: all 0.3s ease;
            position: relative;
        }

        .appointment-card-flat:hover {
            transform: translateX(8px);
            box-shadow: 0 10px 25px rgba(67, 97, 238, 0.15);
        }

        /* Glass Containers */
        .glass-card {
            background: var(--glass-bg);
            border-radius: 24px;
            border: 1px solid rgba(255,255,255,0.6);
            box-shadow: 0 10px 40px rgba(0,0,0,0.04);
            height: 100%;
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        }

        /* Typography Enhancements */
        h2, h5 {
            letter-spacing: -0.02em;
        }

        .fw-bold {
            font-weight: 700 !important;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
{% endblock %}

{% block dashboard_content %}
    {# Hero #}
    <div class="patient-hero">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h2 class="fw-bold mb-2">Hello, {{ patient.user.fullName }}!</h2>
                <p class="mb-0 opacity-75">Your overall health is looking great this month. Keep up the healthy habits!</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <div class="d-inline-flex align-items-center gap-3">
                    <div class="text-end">
                        <div class="fw-bold fs-5">Health Score</div>
                        <div class="small opacity-75">based on latest 5 records</div>
                    </div>
                    <div class="health-score-circle">
                        {{ health_score }}%
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Vitals Summary #}
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="vitals-card">
                <div class="vitals-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-heart-pulse-fill"></i></div>
                <div>
                    <div class="small text-muted">Blood Pressure</div>
                    <div class="fw-bold">{{ (latest_vitals and latest_vitals.bp) ? latest_vitals.bp : '120/80' }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="vitals-card">
                <div class="vitals-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-thermometer-half"></i></div>
                <div>
                    <div class="small text-muted">Temperature</div>
                    <div class="fw-bold">{{ (latest_vitals and latest_vitals.temp) ? latest_vitals.temp : '36.6' }}°C</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="vitals-card">
                <div class="vitals-icon bg-info bg-opacity-10 text-info"><i class="bi bi-speedometer2"></i></div>
                <div>
                    <div class="small text-muted">Body Weight</div>
                    <div class="fw-bold">{{ (latest_vitals and latest_vitals.weight) ? latest_vitals.weight : '68.5' }} kg</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="vitals-card">
                <div class="vitals-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-droplet-fill"></i></div>
                <div>
                    <div class="small text-muted">Blood Group</div>
                    <div class="fw-bold">{{ patient.bloodGroup|default('Not Set') }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        {# Health Progress Chart #}
        <div class="col-lg-8">
            <div class="glass-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Weight & Health Trend</h5>
                    <div class="bg-light rounded-pill p-1">
                        <button class="btn btn-sm btn-white rounded-pill shadow-sm px-3 small fw-bold">6 Months</button>
                        <button class="btn btn-sm text-muted px-3 small fw-bold">1 Year</button>
                    </div>
                </div>
                <canvas id="healthTrendChart" height="280"></canvas>
            </div>
        </div>

        {# Upocming Appointments #}
        <div class="col-lg-4">
            <div class="glass-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Upcoming Visits</h5>
                    <a href="{{ path('app_appointment_new') }}" class="btn btn-sm btn-outline-primary rounded-circle"><i class="bi bi-plus-lg"></i></a>
                </div>
                
                {% for appointment in upcoming_appointments %}
                    <div class="appointment-card-flat">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small fw-bold text-primary">{{ appointment.appointmentDate|date('M d, Y') }} at {{ appointment.appointmentDate|date('H:i') }}</span>
                            <span class="badge bg-primary bg-opacity-10 text-primary small">{{ appointment.status|capitalize }}</span>
                        </div>
                        <div class="fw-bold mb-1">Dr. {{ appointment.doctor.user.fullName }}</div>
                        <div class="small text-muted">{{ appointment.doctor.department.name }}</div>
                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <i class="bi bi-calendar-x text-muted fs-1 d-block mb-3"></i>
                        <p class="text-muted small">No upcoming appointments scheduled.</p>
                        <a href="{{ path('app_appointment_new') }}" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm">Book a Visit</a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="row g-4">
        {# Recent Records Feed #}
        <div class="col-lg-8">
            <div class="glass-card p-4">
                <h5 class="fw-bold mb-4">Recent Medical Activity</h5>
                <div class="list-group list-group-flush">
                    {% for record in medical_records %}
                        <div class="list-group-item bg-transparent px-0 border-0 mb-3">
                            <div class="p-3 rounded-4 bg-light bg-opacity-50 d-flex align-items-center gap-3">
                                <div class="bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center text-primary" style="width: 45px; height: 45px; flex-shrink: 0;">
                                    <i class="bi bi-file-earmark-text"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">{{ record.diagnosis|slice(0, 50) }}...</div>
                                    <div class="small text-muted">Diagnostic result by Dr. {{ record.appointment.doctor.user.fullName }} on {{ record.createdAt|date('M d, Y') }}</div>
                                </div>
                                <a href="{{ path('app_medical_record_show', {id: record.id}) }}" class="btn btn-white btn-sm rounded-pill border shadow-sm px-3 fw-bold">View Report</a>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-4">
                            <p class="text-muted small">No recent activity detected.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Quick Actions & Settings #}
        <div class="col-lg-4">
            <div class="glass-card p-4">
                <h5 class="fw-bold mb-4">Quick Shortcuts</h5>
                <div class="d-grid gap-3">
                    <a href="{{ path('app_appointment_index') }}" class="btn btn-light rounded-4 p-3 text-start d-flex align-items-center gap-3">
                        <i class="bi bi-clock-history text-primary fs-5"></i>
                        <div class="fw-bold">My Appointment History</div>
                    </a>
                    <a href="{{ path('app_medical_record_index') }}" class="btn btn-light rounded-4 p-3 text-start d-flex align-items-center gap-3">
                        <i class="bi bi-shield-lock text-success fs-5"></i>
                        <div class="fw-bold">Medical Data Vault</div>
                    </a>
                    <a href="{{ path('app_patient_edit', {id: patient.id}) }}" class="btn btn-light rounded-4 p-3 text-start d-flex align-items-center gap-3">
                        <i class="bi bi-person-gear text-info fs-5"></i>
                        <div class="fw-bold">Manage My Profile</div>
                    </a>
                </div>
                
                <div class="mt-4 p-3 rounded-4 bg-primary bg-opacity-10">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-info-circle-fill text-primary"></i>
                        <span class="fw-bold small">Emergency?</span>
                    </div>
                    <p class="small text-muted mb-0">Call the hospital hotline at <br><span class="fw-bold text-dark">1-800-HMS-HELP</span></p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
    // Health Progress Chart
    new Chart(document.getElementById('healthTrendChart'), {
        type: 'line',
        data: {
            labels: {{ vitals_history.dates|json_encode|raw }},
            datasets: [
                {
                    label: 'Weight (kg)',
                    data: {{ vitals_history.weight|json_encode|raw }},
                    borderColor: '#05cd99',
                    backgroundColor: 'rgba(5, 205, 153, 0.1)',
                    yAxisID: 'y',
                    fill: true,
                    tension: 0.4
                },
                {
                    label: 'Systolic BP',
                    data: {{ vitals_history.bp_systolic|json_encode|raw }},
                    borderColor: '#4361ee',
                    backgroundColor: 'transparent',
                    yAxisID: 'y1',
                    borderDash: [5, 5],
                    tension: 0.4
                }
            ]
        },
        options: {
            plugins: { legend: { position: 'bottom' } },
            scales: {
                y: { type: 'linear', display: true, position: 'left', grid: { display: false } },
                y1: { type: 'linear', display: true, position: 'right', grid: { borderDash: [5, 5] } }
            }
        }
    });
</script>
{% endblock %}
