{% extends 'dashboard_layout.html.twig' %}

{% block dashboard_title %}Appointment Details{% endblock %}

{% block dashboard_content %}
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Appointment #{{ appointment.tokenNumber }}</h4>
            <div>
                <a href="{{ path('app_appointment_index') }}" class="btn btn-light rounded-pill shadow-sm me-2">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
                <a href="{{ path('app_appointment_edit', {'id': appointment.id}) }}" class="btn btn-primary rounded-pill shadow-sm">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <!-- Appointment Info -->
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-info-circle me-2"></i>Appointment Info</h5>
                    <div class="table-responsive">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <th class="text-muted w-25">Token</th>
                                    <td class="fw-bold fs-5">{{ appointment.tokenNumber }}</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">Date</th>
                                    <td>{{ appointment.appointmentDate|date('M d, Y') }}</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">Time</th>
                                    <td>{{ appointment.appointmentDate|date('H:i') }}</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">Status</th>
                                    <td>
                                        {% set badge_class = 'bg-secondary' %}
                                        {% if appointment.status == 'confirmed' or appointment.status == 'Confirmed' %}{% set badge_class = 'bg-primary' %}
                                        {% elseif appointment.status == 'completed' or appointment.status == 'Completed' %}{% set badge_class = 'bg-success' %}
                                        {% elseif appointment.status == 'cancelled' or appointment.status == 'Cancelled' %}{% set badge_class = 'bg-danger' %}
                                        {% elseif appointment.status == 'Pending' %}{% set badge_class = 'bg-warning' %}
                                        {% endif %}
                                        <span class="badge rounded-pill {{ badge_class }}">{{ appointment.status|capitalize }}</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <!-- Patient & Doctor Info -->
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-people me-2"></i>People Involved</h5>
                    
                    <div class="mb-4">
                        <label class="small text-muted text-uppercase fw-bold mb-1">Patient</label>
                        <div class="d-flex align-items-center">
                            <div class="avatar-circle bg-info bg-opacity-10 text-info me-3">
                                {{ appointment.patient.user.fullName|first|upper }}
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold"><a href="{{ path('app_patient_show', {'id': appointment.patient.id}) }}" class="text-decoration-none text-dark">{{ appointment.patient.user.fullName }}</a></h6>
                                <small class="text-muted">{{ appointment.patient.user.email }}</small>
                            </div>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="small text-muted text-uppercase fw-bold mb-1">Doctor</label>
                        <div class="d-flex align-items-center">
                            <div class="avatar-circle bg-success bg-opacity-10 text-success me-3">
                                {{ appointment.doctor.user.lastName|first|upper }}
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold"><a href="{{ path('app_doctor_show', {'id': appointment.doctor.id}) }}" class="text-decoration-none text-dark">Dr. {{ appointment.doctor.user.fullName }}</a></h6>
                                <small class="text-muted">{{ appointment.doctor.department.name }}</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <!-- Medical Notes -->
                <div class="glass-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-file-medical me-2"></i>Medical Records</h5>
                        {% if appointment.medicalRecord %}
                            <a href="{{ path('app_medical_record_show', {'id': appointment.medicalRecord.id}) }}" class="btn btn-sm btn-outline-success rounded-pill">
                                <i class="bi bi-eye me-1"></i> View Record
                            </a>
                        {% else %}
                            <a href="{{ path('app_medical_record_new', {'appointment': appointment.id}) }}" class="btn btn-sm btn-success rounded-pill">
                                <i class="bi bi-plus-lg me-1"></i> Create Record
                            </a>
                        {% endif %}
                    </div>
                    
                    <div class="bg-light bg-opacity-50 p-3 rounded-3 border border-light">
                        <label class="small text-muted text-uppercase fw-bold mb-2">Booking Notes</label>
                        <p class="mb-0 text-dark">{{ appointment.notes ?: 'No notes provided by the patient.' }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
