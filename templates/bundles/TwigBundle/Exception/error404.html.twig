{% extends 'base.html.twig' %}

{% block title %}404 - Area Restricted | MediCore{% endblock %}

{% block navbar %}{% endblock %}

{% block body %}
<section class="min-vh-100 d-flex align-items-center justify-content-center position-relative overflow-hidden" style="background: #0f172a;">
    {# Background Tech Pattern #}
    <div class="position-absolute top-0 start-0 w-100 h-100 opacity-10" style="background-image: radial-gradient(#4361ee 1px, transparent 1px); background-size: 30px 30px;"></div>
    
    <div class="container position-relative z-1 text-center animate__animated animate__fadeIn">
        <div class="mb-5">
            <h1 class="display-1 fw-bold text-primary mb-0" style="font-size: 15rem; opacity: 0.1; letter-spacing: -20px;">404</h1>
            <div class="mt-n5 position-relative" style="margin-top: -120px !important;">
                <div class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 px-3 py-1 rounded-pill mb-4 uppercase tracking-widest small">
                    <i class="bi bi-shield-lock-fill me-2"></i>Access Protocol Denied
                </div>
                <h2 class="display-4 fw-bold text-white mb-3">Path Not Found</h2>
                <p class="lead text-white opacity-50 mx-auto" style="max-width: 500px;">
                    The medical resource or system node you are looking for does not exist or has been relocated within the network.
                </p>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3 mt-5">
            <a href="{{ path('app_home') }}" class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-lg">
                <i class="bi bi-house-door-fill me-2"></i>Return to Base
            </a>
            <button onclick="window.history.back()" class="btn btn-outline-light rounded-pill px-5 py-3 border-2">
                <i class="bi bi-arrow-left me-2"></i>Initiate Rollback
            </button>
        </div>

        {# System Pulse Stats Overlay #}
        <div class="mt-5 pt-5 opacity-25">
            <div class="d-inline-flex gap-4 text-white small uppercase tracking-widest">
                <span>Node: HMS-OS-2026</span>
                <span>•</span>
                <span>Latency: 12ms</span>
                <span>•</span>
                <span>Status: Scanning...</span>
            </div>
        </div>
    </div>
</section>
{% endblock %}
