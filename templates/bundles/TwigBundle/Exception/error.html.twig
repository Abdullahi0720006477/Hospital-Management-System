{% extends 'base.html.twig' %}

{% block title %}System Error | MediCore Ecosystem{% endblock %}

{% block navbar %}{% endblock %}

{% block body %}
<section class="min-vh-100 d-flex align-items-center justify-content-center position-relative overflow-hidden" style="background: #1e293b;">
    <div class="position-absolute top-0 start-0 w-100 h-100 opacity-20" style="background: radial-gradient(circle at 70% 30%, #4361ee 0%, transparent 50%);"></div>
    
    <div class="container position-relative z-1 text-center">
        <div class="glass-card d-inline-block p-5 border-0 shadow-lg animate__animated animate__pulse animate__infinite" style="max-width: 600px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05) !important;">
            <div class="rounded-circle bg-danger bg-opacity-20 text-danger d-inline-flex align-items-center justify-content-center mb-4 shadow" style="width: 100px; height: 100px;">
                <i class="bi bi-radioactive display-3"></i>
            </div>
            <h1 class="display-5 fw-bold text-white mb-3">System Instability Detected</h1>
            <p class="lead text-white opacity-75 mb-5">
                The central orchestration layer encountered an unexpected exception. Our technical core has been notified for immediate resolution.
            </p>
            
            <div class="d-flex flex-column gap-3">
                <a href="{{ path('app_home') }}" class="btn btn-danger rounded-pill px-5 py-3 fw-bold shadow-lg">
                    <i class="bi bi-lightning-charge-fill me-2"></i>Attempt System Boot
                </a>
                <a href="{{ path('app_contact') }}" class="btn btn-link text-white opacity-50 text-decoration-none small">
                    Report Outage to Command Center
                </a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
