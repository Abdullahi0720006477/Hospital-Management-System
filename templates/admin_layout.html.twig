<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin Dashboard | MediCore{% endblock %}</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    {% block stylesheets %}
    <style>
        /* 2026 Admin Design System */
        :root {
            --primary-blue: #4361ee;
            --secondary-purple: #7209b7;
            --soft-bg: #f8fafc;
            --card-bg: #ffffff;
            --text-primary: #2b3674;
            --text-secondary: #a3aed0;
            --sidebar-bg: #ffffff;
            --glass-border: 1px solid rgba(255, 255, 255, 0.5);
            --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
            --sidebar-width: 280px;
        }

        /* Dark Mode Variables */
        body.dark-mode {
            --soft-bg: #0f172a;
            --card-bg: #1e293b;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --sidebar-bg: #1e293b;
            --glass-border: 1px solid rgba(255, 255, 255, 0.05);
            --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        body {
            background: url('https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&q=80&w=2000') no-repeat center center fixed;
            background-size: cover;
            color: var(--text-primary);
            font-family: 'Outfit', sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
            overflow-x: hidden;
            margin: 0;
            min-height: 100vh;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(248, 250, 252, 0.95); /* Light mode overlay */
            z-index: -1;
        }

        body.dark-mode::before {
            background: rgba(15, 23, 42, 0.95); /* Dark mode overlay */
        }

        /* Premium Sidebar Refined */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg); /* Opaque for clearer separation */
            border-right: none;
            box-shadow: 4px 0 24px rgba(0,0,0,0.02);
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            z-index: 1000;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 1rem 0.6rem;
        }

        .logo-icon-premium {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, var(--primary-blue), var(--secondary-purple));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.4rem;
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.25);
        }

        .nav-link-custom {
            color: var(--text-secondary);
            padding: 0.9rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 12px;
            border-radius: 12px;
            transition: all 0.2s ease;
            text-decoration: none;
            font-weight: 500;
            margin-bottom: 0.3rem;
            border: 1px solid transparent;
        }

        .nav-link-custom:hover {
            background: var(--soft-bg);
            color: var(--primary-blue);
            transform: translateX(4px);
        }

        .nav-link-custom.active {
            background: linear-gradient(90deg, var(--primary-blue), #5b7fff);
            color: white;
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .nav-icon-box {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: rgba(163, 174, 208, 0.1);
            transition: all 0.2s ease;
            font-size: 1rem;
        }

        .nav-link-custom:hover .nav-icon-box {
            background: white;
            color: var(--primary-blue);
        }

        .nav-link-custom.active .nav-icon-box {
            background: rgba(255, 255, 255, 0.2);
            color: white;
        }

        .sidebar-header {
            padding: 0.5rem 1rem 2rem;
        }

        .nav-category {
            font-size: 0.7rem;
            font-weight: 800;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 1.5rem 1.2rem 0.5rem;
            opacity: 0.7;
        }

        /* Distinct Card & Table Styling */
        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
        }

        .glass-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
        }

        .table-custom {
            margin-bottom: 0;
            vertical-align: middle;
        }

        .table-custom thead th {
            background: var(--soft-bg);
            color: var(--text-secondary);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
            padding: 1rem 1.5rem;
            border-bottom: none;
        }

        .table-custom tbody td {
            padding: 1rem 1.5rem;
            color: var(--text-primary);
            border-bottom: 1px solid rgba(0,0,0,0.03);
            font-size: 0.9rem;
        }

        .table-custom tbody tr:hover {
            background-color: var(--soft-bg);
        }

        .table-custom tbody tr:last-child td {
            border-bottom: none;
        }

        /* Main Content Area */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 2rem;
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        /* Topbar Styling */
        .topbar {
            margin-bottom: 2rem;
            padding: 1rem 0;
        }

        .top-search-bar {
            background: var(--card-bg);
            border: var(--glass-border);
            border-radius: 50px;
            padding: 0.6rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
            width: 300px;
            box-shadow: var(--card-shadow);
            transition: all 0.3s ease;
        }

        .top-search-bar input {
            border: none;
            background: transparent;
            outline: none;
            width: 100%;
            color: var(--text-primary);
        }

        /* Theme Toggle */
        .theme-toggle-wrapper {
            position: fixed;
            bottom: 30px;
            left: 30px;
            z-index: 1001;
        }

        .btn-theme-toggle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: none;
            background: var(--card-bg);
            color: var(--text-primary);
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-theme-toggle:hover {
            transform: rotate(15deg) scale(1.1);
        }

        /* AI Chatbot Widget - Reused Premium Style */
        .chatbot-wrapper {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 1002;
        }

        .chatbot-toggle {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border: none;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 10px 30px rgba(67, 97, 238, 0.4);
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
        }

        .chatbot-toggle:hover {
            transform: scale(1.1) translateY(-5px);
        }

        .chatbot-window {
            position: absolute;
            bottom: 80px;
            right: 0;
            width: 350px;
            height: 500px;
            background: var(--card-bg);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            opacity: 0;
            transform: translateY(20px) scale(0.9);
            pointer-events: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: var(--glass-border);
        }

        .chatbot-window.active {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: all;
        }

        .chatbot-header {
            background: linear-gradient(135deg, #4361ee, #7209b7);
            padding: 1rem;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .chatbot-body {
            flex: 1;
            padding: 1rem;
            overflow-y: auto;
            background: var(--soft-bg);
        }

        .chat-message {
            margin-bottom: 1rem;
            display: flex;
        }

        .chat-message.bot .message-content {
            background: var(--card-bg);
            color: var(--text-primary);
            border-radius: 12px 12px 12px 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .chat-message.user {
            justify-content: flex-end;
        }

        .chat-message.user .message-content {
            background: var(--primary-blue);
            color: white;
            border-radius: 12px 12px 0 12px;
        }

        .message-content {
            padding: 0.8rem 1rem;
            font-size: 0.9rem;
            max-width: 80%;
        }

        .system-update-card {
            background: var(--card-bg);
            padding: 0.8rem;
            border-radius: 12px;
            margin-bottom: 0.8rem;
            display: flex;
            align-items: center;
            gap: 10px;
            border-left: 3px solid #05cd99;
        }

        .system-update-card .update-icon {
            width: 30px;
            height: 30px;
            background: rgba(5, 205, 153, 0.1);
            color: #05cd99;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .chatbot-footer {
            padding: 1rem;
            background: var(--card-bg);
            border-top: 1px solid rgba(0,0,0,0.05);
        }

        /* Shared Utilities */
        .avatar-premium {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #FF9F1C, #FF5C5C);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 0.9rem;
            border: 2px solid white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

        .premium-alert {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            color: white;
        }
        
        .alert-success { background: linear-gradient(135deg, #05cd99, #00a878); }
        .alert-danger { background: linear-gradient(135deg, #ff5c5c, #ff3b3b); }
        /* Mobile Responsive Sidebar */
        @media (max-width: 991.98px) {
            .sidebar {
                left: calc(var(--sidebar-width) * -1);
            }
            .sidebar.show {
                left: 0;
            }
            .main-content {
                margin-left: 0 !important;
            }
            .top-search-bar {
                width: 150px;
            }
        }
    </style>
    {% block admin_stylesheets %}{% endblock %}
    {% endblock %}
</head>
<body>
    <div class="main-wrapper">
        {# Theme Toggle #}
        <div class="theme-toggle-wrapper">
            <button class="btn btn-theme-toggle" id="themeToggle" title="Toggle Dark/Light Mode">
                <i class="bi bi-moon-stars-fill"></i>
            </button>
        </div>

        {# Sidebar #}
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="d-flex align-items-center gap-3">
                    <img src="{{ asset('images/logo.png') }}" alt="Logo" style="max-height: 50px;">
                    <div>
                        <h5 class="logo-text fw-bold mb-0">{{ system_settings.hospitalName|default('MediCore')|split(' ')|first }} <span class="text-primary">{{ system_settings.hospitalName|default('Admin')|split(' ')|slice(1)|join(' ') }}</span></h5>
                        <small class="text-muted" style="font-size: 0.65rem;">{{ system_settings.dashboardTitle|default('HOSPITAL OS v2.0') }}</small>
                    </div>
                </div>
            </div>
            
            <div class="sidebar-content">
                <div class="nav-category">MAIN MENU</div>
                <a href="{{ path('app_admin_dashboard') }}" class="nav-link-custom {{ app.request.get('_route') == 'app_admin_dashboard' ? 'active' : '' }}">
                    <div class="nav-icon-box"><i class="bi bi-grid-fill"></i></div>
                    <span>Dashboard</span>
                </a>
                <a href="{{ path('app_appointment_index') }}" class="nav-link-custom {{ app.request.get('_route') == 'app_appointment_index' ? 'active' : '' }}">
                    <div class="nav-icon-box"><i class="bi bi-calendar-event"></i></div>
                    <span>Appointments</span>
                </a>
                <a href="{{ path('app_doctor_index') }}" class="nav-link-custom {{ app.request.get('_route') == 'app_doctor_index' ? 'active' : '' }}">
                    <div class="nav-icon-box"><i class="bi bi-person-badge"></i></div>
                    <span>Doctors</span>
                </a>
                <a href="{{ path('app_patient_index') }}" class="nav-link-custom {{ app.request.get('_route') == 'app_patient_index' ? 'active' : '' }}">
                    <div class="nav-icon-box"><i class="bi bi-people"></i></div>
                    <span>Patients</span>
                </a>
                <a href="{{ path('app_department_index') }}" class="nav-link-custom {{ app.request.get('_route') == 'app_department_index' ? 'active' : '' }}">
                    <div class="nav-icon-box"><i class="bi bi-building"></i></div>
                    <span>Departments</span>
                </a>

                <div class="nav-category">SYSTEM VIEWS</div>
                <a href="{{ path('app_doctor_dashboard') }}" class="nav-link-custom">
                    <div class="nav-icon-box"><i class="bi bi-person-workspace"></i></div>
                    <span>Doctor Portal</span>
                </a>
                <a href="{{ path('app_patient_dashboard') }}" class="nav-link-custom">
                    <div class="nav-icon-box"><i class="bi bi-heart-pulse"></i></div>
                    <span>Patient Portal</span>
                </a>

                <div class="nav-category">ADMINISTRATION</div>
                <a href="{{ path('app_admin_settings') }}" class="nav-link-custom {{ app.request.get('_route') == 'app_admin_settings' ? 'active' : '' }}">
                    <div class="nav-icon-box"><i class="bi bi-gear-fill"></i></div>
                    <span>System Settings</span>
                </a>
                <a href="{{ path('app_admin_audit_logs') }}" class="nav-link-custom {{ app.request.get('_route') == 'app_admin_audit_logs' ? 'active' : '' }}">
                    <div class="nav-icon-box"><i class="bi bi-shield-lock-fill"></i></div>
                    <span>Audit Logs</span>
                </a>
                <a href="{{ path('app_logout') }}" class="nav-link-custom text-danger">
                    <div class="nav-icon-box bg-danger bg-opacity-10 text-danger"><i class="bi bi-box-arrow-right"></i></div>
                    <span>Logout</span>
                </a>
            </div>
        </nav>

        {# Main Content Area #}
        <main class="main-content">
            {# Top Navigation #}
            <header class="topbar d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-4">
                    <button class="btn btn-link text-dark p-0 d-lg-none" id="sidebarToggle"><i class="bi bi-list fs-4"></i></button>
                    <div class="top-search-bar">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search patients, doctors...">
                    </div>
                </div>
                
                <div class="d-flex align-items-center gap-4">
                    <div class="dropdown">
                        <button class="btn btn-icon-premium position-relative" data-bs-toggle="dropdown">
                            <i class="bi bi-bell"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white p-1" style="font-size: 0.5rem;">3</span>
                        </button>
                    </div>
                    <div class="user-profile d-flex align-items-center gap-3">
                        <div class="text-end d-none d-md-block">
                            <div class="fw-bold small user-name">{{ app.user.fullName|default('Admin') }}</div>
                            <div class="text-muted" style="font-size: 0.7rem;">Super Admin</div>
                        </div>
                        <div class="avatar-premium">
                            {{ app.user.email|slice(0,2)|upper }}
                        </div>
                    </div>
                </div>
            </header>

            {# Dynamic Page Content #}
            <div class="content-wrapper">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show premium-alert" role="alert">
                            <i class="bi {{ label == 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' }} me-2"></i>
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
                
                {% block dashboard_content %}{% endblock %}
            </div>
        </main>

        {# AI Chatbot Widget #}
        <div class="chatbot-wrapper">
            <button class="chatbot-toggle" id="chatbotToggle">
                <div class="chatbot-icon">
                    <i class="bi bi-robot"></i>
                </div>
                <div class="chatbot-pulse"></div>
            </button>
            
            <div class="chatbot-window" id="chatbotWindow">
                <div class="chatbot-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="chatbot-avatar">
                            <i class="bi bi-robot"></i>
                        </div>
                        <div>
                            <div class="fw-bold">System AI</div>
                            <div class="d-flex align-items-center gap-1 small opacity-75">
                                <span class="status-dot"></span> Online
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-link text-white p-0" id="chatbotClose"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="chatbot-body" id="chatbotBody">
                    <div class="chat-message bot">
                        <div class="message-content">
                            Hello Admin! 👋 I'm monitoring the system in real-time. Here are the latest system updates:
                        </div>
                    </div>
                    <div class="system-update-card">
                        <div class="update-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                        <div>
                            <div class="fw-bold small">System Performance</div>
                            <div class="text-muted extra-small">Server load optimal at 12% usage.</div>
                        </div>
                    </div>
                    <div class="system-update-card">
                        <div class="update-icon warning"><i class="bi bi-shield-exclamation"></i></div>
                        <div>
                            <div class="fw-bold small">Security Alert</div>
                            <div class="text-muted extra-small">3 failed login attempts detected in last hour.</div>
                        </div>
                    </div>
                </div>
                <div class="chatbot-footer">
                    <div class="input-group">
                        <input type="text" class="form-control border-0 bg-light small" placeholder="Ask system status..." id="chatbotInput">
                        <button class="btn btn-primary" id="chatbotSend"><i class="bi bi-send-fill"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Sidebar Toggle for Mobile
            const sidebar = document.querySelector('.sidebar');
            const sidebarToggle = document.getElementById('sidebarToggle');
            const mainContent = document.querySelector('.main-content');
            
            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', () => {
                    sidebar.classList.toggle('show');
                });
            }

            // Command Palette (Ctrl+K) Simulation
            document.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                    e.preventDefault();
                    showCommandPalette();
                }
            });

            function showCommandPalette() {
                const query = prompt("MediCore Command Center: Enter search or command\n(Available: /doctor, /patient, /settings, emergency)");
                if (!query) return;
                
                if (query.startsWith('/')) {
                    const route = query.substring(1).toLowerCase();
                    const routes = {
                        'doctor': '{{ path('app_doctor_index') }}',
                        'patient': '{{ path('app_patient_index') }}',
                        'settings': '{{ path('app_admin_settings') }}',
                        'logs': '{{ path('app_admin_audit_logs') }}'
                    };
                    if (routes[route]) window.location.href = routes[route];
                } else if (query.toLowerCase() === 'emergency') {
                    alert("🚨 EMERGENCY PROTOCOLS INITIATED. Notifying shift supervisors...");
                }
            }

            // Theme Toggle Logic
            const themeToggle = document.getElementById('themeToggle');
            const body = document.body;
            const icon = themeToggle.querySelector('i');
            
            // Check local storage
            const currentTheme = localStorage.getItem('theme');
            if (currentTheme === 'dark') {
                body.classList.add('dark-mode');
                icon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
            }

            themeToggle.addEventListener('click', () => {
                body.classList.toggle('dark-mode');
                const isDark = body.classList.contains('dark-mode');
                
                if (isDark) {
                    icon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
                    localStorage.setItem('theme', 'dark');
                } else {
                    icon.classList.replace('bi-sun-fill', 'bi-moon-stars-fill');
                    localStorage.setItem('theme', 'light');
                }
            });

            // Chatbot Logic
            const chatbotToggle = document.getElementById('chatbotToggle');
            const chatbotWindow = document.getElementById('chatbotWindow');
            const chatbotClose = document.getElementById('chatbotClose');
            const chatbotInput = document.getElementById('chatbotInput');
            const chatbotSend = document.getElementById('chatbotSend');
            const chatbotBody = document.getElementById('chatbotBody');

            chatbotToggle.addEventListener('click', () => {
                chatbotWindow.classList.toggle('active');
                chatbotToggle.classList.toggle('active');
                if (chatbotWindow.classList.contains('active')) {
                    chatbotInput.focus();
                }
            });

            chatbotClose.addEventListener('click', () => {
                chatbotWindow.classList.remove('active');
                chatbotToggle.classList.remove('active');
            });

            function addMessage(text, isUser = false) {
                const msgDiv = document.createElement('div');
                msgDiv.className = `chat-message ${isUser ? 'user' : 'bot'}`;
                msgDiv.innerHTML = `<div class="message-content">${text}</div>`;
                chatbotBody.appendChild(msgDiv);
                chatbotBody.scrollTop = chatbotBody.scrollHeight;
            }

            function handleChat() {
                const text = chatbotInput.value.trim();
                if (!text) return;

                addMessage(text, true);
                chatbotInput.value = '';

                // Simulated AI Response
                setTimeout(() => {
                    const responses = [
                        "I've checked the system logs. Everything is running smoothly.",
                        "Database latency is currently 24ms, which is excellent.",
                        "There are 5 active doctors currently logged in.",
                        "Backup was completed successfully at 02:00 AM today."
                    ];
                    const randomResponse = responses[Math.floor(Math.random() * responses.length)];
                    addMessage(randomResponse, false);
                }, 1000);
            }

            chatbotSend.addEventListener('click', handleChat);
            chatbotInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') handleChat();
            });
        });
    </script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>
