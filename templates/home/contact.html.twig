{% extends 'base.html.twig' %}

{% block title %}Contact Us | {{ system_settings.hospitalName|default('MediCore Hospital') }}{% endblock %}

{% block stylesheets %}
<style>
    .contact-hero {
        padding: 120px 0 60px;
        background: linear-gradient(135deg, #4361ee 0%, #7209b7 100%);
        color: white;
        text-align: center;
    }
    .contact-info-card {
        padding: 2rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    .contact-icon {
        width: 50px;
        height: 50px;
        background: rgba(67, 97, 238, 0.1);
        color: #4361ee;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 1.5rem;
    }
    /* Map Styling */
    #map { border-radius: 20px; }
    .leaflet-container { font-family: 'Outfit', sans-serif; }
</style>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
{% endblock %}

{% block body %}
<!-- Radiant Hero Section -->
<section class="min-vh-50 d-flex align-items-center justify-content-center position-relative overflow-hidden" 
         style="background: radial-gradient(circle at top right, #4361ee, #0f172a 60%); padding: 160px 0 100px;">
    <div class="position-absolute top-0 start-0 w-100 h-100 opacity-25" 
         style="background-image: radial-gradient(#4cc9f0 1px, transparent 1px); background-size: 30px 30px;"></div>
    
    <div class="container position-relative text-center animate__animated animate__fadeIn">
        <div class="badge bg-primary bg-opacity-20 text-info border border-info border-opacity-25 px-3 py-2 rounded-pill mb-4 uppercase tracking-widest small">
            Connect with Excellence
        </div>
        <h1 class="display-3 fw-bold text-white mb-3 tracking-tighter">Human-Centric Support</h1>
        <p class="lead text-white opacity-75 mx-auto" style="max-width: 600px;">
            Whether you're a patient seeking care or a professional inquiring about our systems, our dedicated team is here to guide you.
        </p>
    </div>
</section>

<section class="py-5" style="background: #0f172a; margin-top: -50px;">
    <div class="container position-relative" style="z-index: 5;">
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="glass-card p-4 text-center border-0 shadow-lg animate__animated animate__fadeInUp" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(20px);">
                    <div class="rounded-circle bg-primary bg-opacity-20 text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-geo-alt-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-white">Main Campus</h5>
                    <p class="text-white opacity-50 small mb-0">123 Academic St, University Hill<br>Building Alpha, Suite 400</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 text-center border-0 shadow-lg animate__animated animate__fadeInUp animate__delay-1s" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(20px);">
                    <div class="rounded-circle bg-info bg-opacity-20 text-info d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-envelope-check-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-white">Digital Support</h5>
                    <p class="text-white opacity-50 small mb-0">care@medicore.os<br>billing@medicore.os</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 text-center border-0 shadow-lg animate__animated animate__fadeInUp animate__delay-2s" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(20px);">
                    <div class="rounded-circle bg-success bg-opacity-20 text-success d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-telephone-inbound-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-white">24/7 Hotline</h5>
                    <p class="text-white opacity-50 small mb-0">+1 (800) MEDI-HMS<br>Emergency: Ext. 999</p>
                </div>
            </div>
        </div>

        <div class="row g-5 align-items-stretch">
            <div class="col-lg-7">
                <div class="glass-card p-5 border-0 shadow-lg" style="background: rgba(255,255,255,0.98);">
                    <h3 class="fw-bold text-dark mb-4">Transmission Channel</h3>
                    <form action="#" method="POST" class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted text-uppercase">Full Identity</label>
                            <input type="text" class="form-control rounded-4 border-0 bg-light p-3" placeholder="Enter name">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted text-uppercase">Email Link</label>
                            <input type="email" class="form-control rounded-4 border-0 bg-light p-3" placeholder="email@address.com">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted text-uppercase">Context of Inquiry</label>
                            <select class="form-select rounded-4 border-0 bg-light p-3">
                                <option>General Consultation</option>
                                <option>Technical Assistance</option>
                                <option>Partnership Inquiry</option>
                                <option>Feedback Protocol</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted text-uppercase">Message Payload</label>
                            <textarea class="form-control rounded-4 border-0 bg-light p-3" rows="6" placeholder="Describe your request in detail..."></textarea>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 shadow-lg fw-bold d-flex align-items-center gap-2">
                                <i class="bi bi-send-check"></i> Initiate Contact
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="col-lg-5">
                <div class="glass-card h-100 overflow-hidden border-0 shadow-lg" style="min-height: 400px; position: relative;">
                    <div id="map" style="height: 100%; width: 100%; filter: grayscale(1) invert(1) contrast(1.2) opacity(0.7);"></div>
                    <div class="position-absolute bottom-0 start-0 w-100 p-4" style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent); z-index: 1000;">
                        <h6 class="text-white fw-bold mb-1">Global HQ</h6>
                        <p class="text-white opacity-75 small mb-0">Open for public visitations Mon-Fri (8AM-6PM)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const map = L.map('map').setView([51.505, -0.09], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);
        L.marker([51.505, -0.09]).addTo(map)
            .bindPopup('<b>MediCore Hospital</b><br>123 Academic St.')
            .openPopup();
            
        const mapContainer = document.getElementById('map');
        mapContainer.style.filter = 'grayscale(1) contrast(1.2) opacity(0.8)';
    });
</script>
{% endblock %}
