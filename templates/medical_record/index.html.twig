{% extends 'page_layout.html.twig' %}

{% block page_title %}Medical Archives{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">Medical Records</li>
{% endblock %}

{% block page_content %}
<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 border-bottom border-light">
        <h4 class="fw-bold mb-0 text-primary">Patient History & Records</h4>
        <div class="text-muted small">
            <i class="bi bi-info-circle me-1"></i> Records are automatically created after appointments
        </div>
    </div>
    
    <div class="table-responsive">
        <table class="table table-hover align-middle table-glass mb-0">
            <thead>
                <tr>
                    <th>Date Recorded</th>
                    <th>Patient Details</th>
                    <th>Attending Doctor</th>
                    <th>Diagnosis Preview</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for medical_record in medical_records %}
                <tr>
                    <td>
                        <div class="fw-bold">{{ medical_record.createdAt|date('M d, Y') }}</div>
                        <small class="text-muted">{{ medical_record.createdAt|date('H:i') }}</small>
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-info bg-opacity-10 d-flex align-items-center justify-content-center text-info" style="width: 35px; height: 35px;">
                                {{ medical_record.patient.user.fullName|slice(0, 1)|upper }}
                            </div>
                            <span class="fw-semibold">{{ medical_record.patient.user.fullName }}</span>
                        </div>
                    </td>
                    <td>Dr. {{ medical_record.appointment.doctor.user.lastName }}</td>
                    <td>
                        <span class="d-inline-block text-truncate text-muted" style="max-width: 200px;">
                            {{ medical_record.diagnosis|default('No diagnosis recorded') }}
                        </span>
                    </td>
                    <td class="text-end">
                        <a href="{{ path('app_medical_record_show', {'id': medical_record.id}) }}" class="btn btn-sm btn-light rounded-pill px-3 shadow-sm border">
                            <i class="bi bi-eye text-primary me-1"></i> View
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center py-5">
                        <div class="text-muted mb-3 opacity-50">
                            <i class="bi bi-folder2-open fs-1"></i>
                        </div>
                        <h6 class="text-muted">No medical records found</h6>
                        <p class="small text-muted">Records will appear here once doctors complete appointments.</p>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
