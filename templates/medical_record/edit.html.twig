{% extends 'dashboard_layout.html.twig' %}

{% block dashboard_title %}Edit Medical Record{% endblock %}

{% block dashboard_content %}
<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="glass-card p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="mb-1 fw-bold text-primary">Edit Consultation Record</h5>
                    <p class="mb-0 text-muted small"><i class="bi bi-calendar-event me-1"></i> Recorded on {{ medical_record.createdAt|date('M d, Y H:i') }}</p>
                </div>
                <div class="text-end">
                    <div class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                        <i class="bi bi-person me-1"></i> Patient: {{ medical_record.patient.user.fullName }}
                    </div>
                </div>
            </div>
        </div>

        {{ form_start(form) }}
        <div class="row g-4">
            <div class="col-md-8">
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold mb-4 text-primary"><i class="bi bi-clipboard-pulse me-2"></i>Clinical Findings</h5>
                    
                    <div class="mb-4">
                        {{ form_label(form.diagnosis, 'Diagnosis & Observations', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.diagnosis, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3', 'rows': '5'}}) }}
                        {{ form_errors(form.diagnosis) }}
                    </div>

                    <div class="mb-0">
                        {{ form_label(form.prescription, 'Prescription', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.prescription, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3', 'rows': '5'}}) }}
                        {{ form_errors(form.prescription) }}
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold mb-4 text-primary"><i class="bi bi-activity me-2"></i>Vital Signs</h5>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-muted">Blood Pressure (mmHg)</label>
                        <div class="input-group">
                            <span class="input-group-text border-0 bg-light rounded-start-3"><i class="bi bi-heart-pulse text-danger"></i></span>
                            <input type="text" name="vital_bp" value="{{ medical_record.vitalSigns.bp|default('') }}" class="form-control border-0 bg-light rounded-end-3 p-2" placeholder="e.g. 120/80">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-muted">Temperature (°C)</label>
                        <div class="input-group">
                            <span class="input-group-text border-0 bg-light rounded-start-3"><i class="bi bi-thermometer-half text-warning"></i></span>
                            <input type="text" name="vital_temp" value="{{ medical_record.vitalSigns.temp|default('') }}" class="form-control border-0 bg-light rounded-end-3 p-2" placeholder="e.g. 36.5">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase text-muted">Weight (kg)</label>
                        <div class="input-group">
                            <span class="input-group-text border-0 bg-light rounded-start-3"><i class="bi bi-speedometer2 text-info"></i></span>
                            <input type="text" name="vital_weight" value="{{ medical_record.vitalSigns.weight|default('') }}" class="form-control border-0 bg-light rounded-end-3 p-2" placeholder="e.g. 70.5">
                        </div>
                    </div>

                    <hr class="my-4 border-secondary opacity-25">

                    <button class="btn btn-primary w-100 py-3 rounded-pill shadow-lg fw-bold mb-3">
                        <i class="bi bi-save me-2"></i> Update Record
                    </button>
                    
                    <a href="{{ path('app_medical_record_show', {'id': medical_record.id}) }}" class="btn btn-light w-100 py-2 rounded-pill text-muted border-0">
                        Cancel
                    </a>
                    
                    <div class="mt-4 pt-3 border-top text-center">
                         <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 border-0" onclick="if(confirm('Are you sure you want to delete this record entirely?')) document.getElementById('delete-record-form').submit();">
                            <i class="bi bi-trash me-1"></i> Delete Record
                         </button>
                    </div>
                </div>
            </div>
        </div>
        {{ form_end(form) }}

        <form id="delete-record-form" method="post" action="{{ path('app_medical_record_delete', {'id': medical_record.id}) }}" class="d-none">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ medical_record.id) }}">
        </form>
    </div>
</div>
{% endblock %}
