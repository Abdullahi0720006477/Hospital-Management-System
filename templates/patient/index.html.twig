{% extends 'page_layout.html.twig' %}

{% block page_title %}Patients{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">Patients</li>
{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_patient_new') }}" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-person-plus-fill me-2"></i>Register Patient
    </a>
{% endblock %}

{% block page_content %}
<div class="glass-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle table-glass" id="patientTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Patient Name</th>
                    <th>Contact Info</th>
                    <th>Blood Group</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for patient in patients %}
                <tr>
                    <td><span class="text-muted">#{{ patient.id }}</span></td>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="avatar-circle bg-info bg-opacity-10 text-info me-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: bold;">
                                {{ patient.user ? patient.user.fullName|slice(0, 1)|upper : 'P' }}
                            </div>
                            <div>
                                <div class="fw-bold">{{ patient.user ? patient.user.fullName : 'Unknown Patient' }}</div>
                                <small class="text-muted">{{ patient.dateOfBirth ? patient.dateOfBirth|date('Y-m-d') : 'DOB N/A' }}</small>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="small">
                            <div class="mb-1"><i class="bi bi-envelope me-2 text-muted"></i>{{ patient.user ? patient.user.email : 'No Email' }}</div>
                            <div><i class="bi bi-telephone me-2 text-muted"></i>{{ patient.phone|default('N/A') }}</div>
                        </div>
                    </td>
                    <td><span class="badge bg-danger rounded-pill">{{ patient.bloodGroup }}</span></td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li><a class="dropdown-item" href="{{ path('app_patient_show', {'id': patient.id}) }}"><i class="bi bi-eye me-2"></i> View Details</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_patient_edit', {'id': patient.id}) }}"><i class="bi bi-pencil me-2"></i> Edit Patient</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
    <style>
        .dataTables_wrapper .dataTables_filter { margin-bottom: 1rem; }
        .dataTables_wrapper .dataTables_paginate { margin-top: 1rem; }
        .avatar-circle { font-size: 1.1rem; }
    </style>
{% endblock %}

{% block javascripts %}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(document).ready(function() {
        $('#patientTable').DataTable({
            "order": [[ 0, "desc" ]],
            "pageLength": 10,
            "language": {
                "search": "_INPUT_",
                "searchPlaceholder": "Search patients..."
            }
        });
    });
</script>
{% endblock %}
