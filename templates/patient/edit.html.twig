{% extends 'page_layout.html.twig' %}

{% block page_title %}Edit Patient{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('app_patient_index') }}">Patients</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_patient_show', {'id': patient.id}) }}">{{ patient.user.fullName }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit</li>
{% endblock %}

{% block page_actions %}
    {{ include('patient/_delete_form.html.twig') }}
{% endblock %}

{% block page_content %}
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="glass-card p-5">
            <h4 class="fw-bold text-primary mb-4 text-center">Edit Patient Information</h4>
            {{ form_start(form) }}
                
                <h5 class="fw-bold text-primary mb-4"><i class="bi bi-person-vcard me-2"></i>Personal Details</h5>
                <div class="row g-4">
                    <div class="col-md-6">
                         {{ form_label(form.dateOfBirth, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                         {{ form_widget(form.dateOfBirth, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3'}}) }}
                    </div>
                    <div class="col-md-6">
                         {{ form_label(form.phone, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                         {{ form_widget(form.phone, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3'}}) }}
                    </div>
                    <div class="col-12">
                         {{ form_label(form.address, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                         {{ form_widget(form.address, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3', 'rows': '3'}}) }}
                    </div>
                     <div class="col-md-6">
                         {{ form_label(form.bloodGroup, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                         {{ form_widget(form.bloodGroup, {'attr': {'class': 'form-select rounded-3 bg-light border-0 p-3'}}) }}
                    </div>
                </div>

                <h5 class="fw-bold text-primary mb-4 mt-5"><i class="bi bi-heart-pulse me-2"></i>Medical & Emergency</h5>
                <div class="row g-4">
                    <div class="col-12">
                         {{ form_label(form.allergies, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                         {{ form_widget(form.allergies, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3', 'rows': '2'}}) }}
                    </div>
                    <div class="col-md-6">
                         {{ form_label(form.emergencyContactName, 'Emergency Contact', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                         {{ form_widget(form.emergencyContactName, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3'}}) }}
                    </div>
                    <div class="col-md-6">
                         {{ form_label(form.emergencyContactPhone, 'Emergency Phone', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                         {{ form_widget(form.emergencyContactPhone, {'attr': {'class': 'form-control rounded-3 bg-light border-0 p-3'}}) }}
                    </div>
                </div>

                <div class="mt-5 d-flex justify-content-between align-items-center">
                    <a href="{{ path('app_patient_index') }}" class="btn btn-light rounded-pill px-4 shadow-sm text-decoration-none text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                    <button class="btn btn-primary rounded-pill px-5 py-3 shadow-lg fw-bold">
                        <i class="bi bi-check-lg me-1"></i> Update Patient
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
